<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.useractivitylogger.controllers.DashboardController"
            style="-fx-padding: 20;">
    <VBox xmlns:fx="http://javafx.com/fxml"
      spacing="20" alignment="TOP_LEFT" style="-fx-padding: 20;">

    <!-- Page Title -->
    <Label text="Dashboard Overview" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E88E5;" />
    <Label text="Welcome to the Admin Dashboard" style="-fx-font-size: 14px; -fx-text-fill: #555;" />

    <!-- KPI Section -->
    <HBox spacing="20">
        <VBox style="-fx-background-color: #2196F3; -fx-padding: 15; -fx-background-radius: 10;" prefWidth="200">
            <Label text="Total Staff" style="-fx-text-fill: white; -fx-font-size: 14;" />
            <Label fx:id="lblTotalStaff" text="0" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" />
        </VBox>
        <VBox style="-fx-background-color: #43A047; -fx-padding: 15; -fx-background-radius: 10;" prefWidth="200">
            <Label text="Present Today" style="-fx-text-fill: white; -fx-font-size: 14;" />
            <Label fx:id="lblPresentToday" text="0" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" />
        </VBox>
        <VBox style="-fx-background-color: #E53935; -fx-padding: 15; -fx-background-radius: 10;" prefWidth="200">
            <Label text="Absent Today" style="-fx-text-fill: white; -fx-font-size: 14;" />
            <Label fx:id="lblAbsentToday" text="0" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" />
        </VBox>
    </HBox>

    <!-- Recent Attendance Table -->
    <Label text="Recent Attendance Logs" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" />
    <TableView fx:id="tblRecentAttendance" prefHeight="200">
        <columns>
            <TableColumn text="Staff Name" fx:id="colStaffName" prefWidth="150"/>
            <TableColumn text="Clock In" fx:id="colClockIn" prefWidth="150"/>
            <TableColumn text="Clock Out" fx:id="colClockOut" prefWidth="150"/>
            <TableColumn text="Summary" fx:id="colTaskSummary" prefWidth="150"/>
        </columns>

    </TableView>

    <!-- Charts Section -->
    <HBox spacing="30" alignment="CENTER">
        <VBox>
            <Label text="Attendance Summary" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            <PieChart fx:id="attendancePieChart" prefWidth="300" prefHeight="250"/>
        </VBox>
        <VBox>
            <Label text="Activity Trend" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            <LineChart fx:id="activityTrendChart" prefWidth="400" prefHeight="250">
                <xAxis>
                    <CategoryAxis label="Date"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Activities"/>
                </yAxis>
            </LineChart>
        </VBox>
    </HBox>

</VBox>
</AnchorPane>