<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.useractivitylogger.controllers.ReportsController"
            fitToWidth="true">
    <content>
        <VBox spacing="20" style="-fx-padding: 20;">

            <!-- Page Title -->
            <Label text="Reports Dashboard" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <!-- Filter Section -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Filter by Staff:" style="-fx-font-size: 14px;"/>
                <ComboBox fx:id="cmbStaffFilter" promptText="Select Staff" style="-fx-pref-width: 200;"/>
                <Button text="Apply Filter" fx:id="btnApplyFilter"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Clear Filter" fx:id="btnClearFilter"
                        style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Activity Trend Chart -->
            <Label text="Staff(s) present per day" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <LineChart fx:id="activityTrendChart" prefHeight="300">
                <xAxis>
                    <CategoryAxis label="Date"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Number of Staff(s)"/>
                </yAxis>
            </LineChart>

            <!-- Attendance Summary Table -->
            <Label text="Attendance Summary" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <TableView fx:id="tblAttendanceSummary" prefHeight="250">
                <columns>
                    <TableColumn text="Staff Name" fx:id="colStaffName" prefWidth="150"/>
                    <TableColumn text="Days Worked" fx:id="colDaysWorked" prefWidth="120"/>
                    <TableColumn text="Days Missed" fx:id="colDaysMissed" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </content>
</ScrollPane>
