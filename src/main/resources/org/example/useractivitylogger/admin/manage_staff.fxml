<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.useractivitylogger.controllers.ManageStaffController"
            fitToWidth="true" style="-fx-padding: 20;">
    <content>
        <VBox spacing="20" alignment="TOP_LEFT" style="-fx-padding: 20;">

            <!-- Page Title -->
            <Label text="Manage Staff" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E88E5;" />

            <!-- Form Section -->
            <VBox spacing="15" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #f4f4f4; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-background-radius: 10;">
                <Label text="Add Staff" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" />

                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="First Name" style="-fx-font-weight: bold;" />
                    <TextField fx:id="txtFirstName" promptText="Enter first name" style="-fx-pref-width: 200;" />
                </VBox>

                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Last Name" style="-fx-font-weight: bold;" />
                    <TextField fx:id="txtLastName" promptText="Enter last name" style="-fx-pref-width: 200;" />
                </VBox>

                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Username" style="-fx-font-weight: bold;" />
                    <TextField fx:id="txtUsername" promptText="Enter username" style="-fx-pref-width: 200;" />
                </VBox>

                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Position" style="-fx-font-weight: bold;" />
                    <TextField fx:id="txtPosition" promptText="Enter position" style="-fx-pref-width: 200;" />
                </VBox>

                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Email" style="-fx-font-weight: bold;" />
                    <TextField fx:id="txtEmail" promptText="Enter email" style="-fx-pref-width: 200;" />
                </VBox>

                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Password" style="-fx-font-weight: bold;" />
                    <PasswordField fx:id="txtPassword" promptText="Enter password" style="-fx-pref-width: 200;" />
                </VBox>

                <Button text="Add Staff" fx:id="btnAddStaff"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 300; -fx-background-radius: 6;" />
            </VBox>

            <!-- Staff Table -->
            <Label text="All Staff" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" />
            <TableView fx:id="tblStaff" prefHeight="300" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFirstName" text="First Name"/>
                    <TableColumn fx:id="colLastName" text="Last Name"/>
                    <TableColumn text="Position" fx:id="colPosition" prefWidth="150"/>
                    <TableColumn text="Email" fx:id="colEmail" prefWidth="200"/>
                    <TableColumn text="Present Days (This Month)" fx:id="colPresentDays" prefWidth="200"/>
                </columns>
            </TableView>

        </VBox>
    </content>
</ScrollPane>
