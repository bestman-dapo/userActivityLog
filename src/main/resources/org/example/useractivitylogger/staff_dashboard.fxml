<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.useractivitylogger.controllers.StaffDashboardController"
            prefWidth="960" prefHeight="600" style="-fx-background-color:#004d4d, #009999;">

    <!-- Top Bar -->
    <VBox spacing="10" alignment="TOP_RIGHT" AnchorPane.topAnchor="10" AnchorPane.rightAnchor="20">
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label text="Logged in as: " style="-fx-font-size: 14px; -fx-text-fill: white;" />
            <Label fx:id="loggedInUserLabel" text="user@example.com" style="-fx-font-size: 14px; -fx-text-fill:white; -fx-font-weight: bold;" />
        </HBox>
        <Button fx:id="logoutButton" text="Logout" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 5 15; -fx-font-size: 13px;" />
    </VBox>


    <VBox spacing="20" alignment="TOP_CENTER" AnchorPane.topAnchor="80" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <!-- Header -->
        <Label text="Staff Dashboard" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;" />

        <!-- Clock In / Clock Out Buttons -->
        <HBox spacing="20" alignment="CENTER">
            <Button fx:id="clockInButton" text="Clock In" style="-fx-background-color:  #43A047; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;" />
            <Button fx:id="clockOutButton" text="Clock Out" style="-fx-background-color: #43A047; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-cursor: hand;" />
        </HBox>

        <!-- Task Summary Input -->
        <VBox spacing="10" maxWidth="600">
            <Label text="Daily Task Summary:" style="-fx-font-size: 16px; -fx-text-fill: white;" />
            <TextArea fx:id="taskSummaryArea" prefRowCount="4" wrapText="true" style="-fx-font-size: 14px; -fx-padding: 10;" />
            <Button fx:id="submitTaskButton" text="Submit Task" style="-fx-background-color: #43A047; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;" />
        </VBox>

        <!-- Activity Log Table -->
        <VBox spacing="10" maxWidth="800">
            <Label text="Your Daily Activity Log" style="-fx-font-size: 18px; -fx-text-fill:white;" />
            <TableView fx:id="activityTable" prefHeight="300">
                <columns>
                    <TableColumn text="Clock In" fx:id="colClockIn" prefWidth="200" />
                    <TableColumn text="Clock Out" fx:id="colClockOut" prefWidth="200" />
                    <TableColumn text="Task Summary" fx:id="colTaskSummary" prefWidth="400" />
                </columns>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>
